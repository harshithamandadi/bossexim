# ── Payload CMS ────────────────────────────────────────────────────────────────
# Signs admin sessions. Use a long random string, different per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Content database (SQLite / libSQL).
#   Local development:  file:./cms-data/bgexim.db   (created by `npm run seed`)
#   Production:         a Turso URL (libsql://…) plus DATABASE_AUTH_TOKEN, or a
#                       file path on a server with persistent disk.
DATABASE_URL=file:./cms-data/bgexim.db
DATABASE_AUTH_TOKEN=

# Optional: `npm run seed` creates this admin account when no users exist yet.
# Otherwise, create the first account at /admin (it becomes an admin automatically).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Sends enquiry alerts to your team, a confirmation to each enquirer, and admin
# password resets — through the company's own mailbox (no paid email service).
# Leave SMTP_HOST empty to switch email off: enquiries are still saved in the
# admin under Inbox → Enquiries. Who receives alerts is set in the admin
# (Settings → Company details → Enquiry emails).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=BOSS Global EXIM

# Optional: the site's public address, used for links in emails (e.g. "View in
# the admin"). Defaults to https://www.bgexim.com.
SITE_URL=

# ── Enquiries ──────────────────────────────────────────────────────────────────
# Optional extra channel: also POST each enquiry as JSON to this URL (Zapier,
# Make, a Slack/Teams workflow or a CRM).
ENQUIRY_WEBHOOK_URL=
